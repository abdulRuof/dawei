# =========================================================
# نموذج الإعدادات — انسخه إلى ".env" وعدّل القيم
#   copy .env.example .env
# =========================================================

# قاعدة البيانات (PostgreSQL)
# مثال SQLite للاختبار السريع:
# DATABASE_URL=sqlite:///./dawei.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dawei

# مفتاح توقيع JWT — غيّره لمفتاح عشوائي طويل
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440